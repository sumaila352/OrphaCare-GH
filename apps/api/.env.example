# --- Database ---
# SQLite (local file, no external DB):
# DATABASE_URL="file:./dev.db"
# PostgreSQL (Neon, Render, etc.):
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
DATABASE_URL="file:./dev.db"
NODE_ENV=development

PORT=4000
CLIENT_URL=http://localhost:3000

# Use a long random string (32+ chars). Required in production.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Google OAuth (same Client ID as web — create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Cloudinary (child photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=orphacare/children

# Admin account (npm run db:seed — local defaults below)
SEED_ADMIN_EMAIL=admin@orphacare.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Administrator

# --- Production (Render API) — set in Render dashboard, not in this file ---
# DATABASE_URL=postgresql://user:password@host:5432/orphacare?sslmode=require
# NODE_ENV=production
# CLIENT_URL=https://your-app.vercel.app
# JWT_SECRET=replace-with-long-random-secret-min-32-chars
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=strong-password-on-first-seed-only
# SEED_DEMO_DATA=false
#
# --- Production (Vercel web) — set in Vercel dashboard ---
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SHOW_DEMO_HINT=false
#
# See DEPLOYMENT.md for full Render + Vercel steps.
