# Production: full URL of your API (required)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Development: leave empty to proxy /api/* to localhost:4000 via next.config rewrites
NEXT_PUBLIC_API_URL=

# Google OAuth — Web client ID (same value as GOOGLE_CLIENT_ID on the API)
# Create at https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

